<%#
    Profile header + posts/following/followers nav. Expects `u` (view_account with the
    Portal's relation data), `isMe`, `section` ('' on the profile top page).
%>
<%
    const name = u.mii_name || u.nnid;
    const userUrl = '/users/' + encodeURIComponent(u.nnid);
    const postCount = u.post_count !== undefined ? u.post_count : (u.posts || []).filter(p => Number(p.moderated) !== 1).length;
%>
<div id="user-content-container">
    <div id="user-content" class="user-page">
        <div id="header">
            <div id="header-body">
                <h1 id="page-title"><span><%= t('user.profile.header.name', ":name's Profile", { name: name }) %></span></h1>
            </div>
        </div>
        <div class="icon-name-container">
            <div class="user-icon-container<%= u.verified || u.admin ? ' official-user' : '' %>">
                <img src="/mii/<%= u.pid || u.nnid || 'default' %>/normal.png" class="user-icon" width="32" height="32" onerror="this.onerror=null; this.src='/img/mii_null.png'">
            </div>
            <p class="title">
                <span class="nick-name"><%= name %></span>
                <span class="id-name"><%= u.nnid %></span>
            </p>
        </div>
    </div>
    <div id="header-meta">
        <% if (section) { %>
            <a href="<%= userUrl %>" class="profile-page-button" data-pjax="1"><%= t('user.profile.meta.back', 'To Top') %></a>
        <% } else if (!isMe && !u.blocked_viewer) { %>
            <div class="button-with-option">
                <div class="toggle-follow-button">
                    <button type="button" data-action="<%= userUrl %>/follow.json" class="follow-button<%= u.is_following ? ' none' : '' %>"><%= t('user.profile.meta.follow', 'Follow') %></button>
                    <button type="button" data-action="<%= userUrl %>/unfollow.json" class="unfollow-button<%= u.is_following ? '' : ' none' %>" data-screen-name="<%= u.nnid %>"><%= t('user.profile.meta.unfollow', 'Unfollow') %></button>
                </div>
            </div>
        <% } %>
    </div>
</div>
<div id="nav-menu" class="nav-3">
    <a href="<%= userUrl %>/posts" data-pjax="1" class="user-posts-count<%= section === 'posts' ? ' selected' : '' %>">
        <span class="number"><%= postCount %></span>
        <span class="name"><%= t('user.profile.nav.posts', 'Posts') %></span>
    </a>
    <a href="<%= userUrl %>/following" data-pjax="1" class="user-followings-count<%= section === 'following' ? ' selected' : '' %>">
        <span class="number"><%= u.following_count || 0 %></span>
        <span class="name"><%= t('user.profile.nav.following', 'Following') %></span>
    </a>
    <a href="<%= userUrl %>/followers" data-pjax="1" class="user-followers-count<%= section === 'followers' ? ' selected' : '' %>">
        <span class="number"><%= u.follower_count || 0 %></span>
        <span class="name"><%= t('user.profile.nav.followers', 'Followers') %></span>
    </a>
</div>
